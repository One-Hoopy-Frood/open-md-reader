# Normalise line endings.
#
# Without this, files flip between CRLF and LF depending on whether they
# came from a git clone, a downloaded zip, or an editor save, which shows
# up as "every file modified" in diffs.
* text=auto

# Always LF in the working tree. Webpack, prettier and node all prefer it,
# and CRLF breaks shebangs and heredocs.
*.ts     text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf
*.cjs    text eol=lf
*.json   text eol=lf
*.less   text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.svelte text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf

# Extensionless and dotfiles that tools parse strictly. nvm and fnm read
# .nvmrc literally, and a trailing CR makes the version unparseable.
.nvmrc          text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.prettierrc     text eol=lf
.prettierignore text eol=lf

# Windows-only scripts need CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch binaries.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary
*.ttf   binary
*.zip   binary
